# ============================================================
# Bitcoin Trading Assistant - Configuration
# ============================================================

# Database
DATABASE_URL=postgresql://btc_user:btc_password_123@localhost:5432/bitcoin_assistant

# Scheduler
# Active/désactive le scheduler automatique
SCHEDULER_ENABLED=false

# Intervalle entre les fetches (en minutes)
# 240 = 4 heures (production)
# 5 = 5 minutes (dev/test)
SCHEDULER_INTERVAL_MINUTES=240

# Paire à fetcher
SCHEDULER_SYMBOL=BTC/USD

# Nombre de jours d'historique (max 30 pour l'instant)
SCHEDULER_DAYS=7
