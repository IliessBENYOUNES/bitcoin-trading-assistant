# =============================================================================
# Bitcoin Trading Assistant - Frontend Environment Variables
# =============================================================================
# 
# INSTRUCTIONS:
# 1. Copier ce fichier vers .env : copy .env.example .env
# 2. Modifier les valeurs selon votre environnement
# 3. Ne JAMAIS committer le fichier .env
#
# =============================================================================

# -----------------------------------------------------------------------------
# API Backend
# -----------------------------------------------------------------------------

# URL de base de l'API backend (sans slash final)
# - Développement local : http://localhost:8000
# - Production : https://api.votre-domaine.com
VITE_API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Feature Flags (optionnel)
# -----------------------------------------------------------------------------

# Activer le mode debug (logs console supplémentaires)
# VITE_DEBUG=false

# Intervalle de polling du scheduler en ms (défaut: 15000 = 15s)
# VITE_SCHEDULER_POLL_INTERVAL=15000

# Activer/désactiver le polling automatique
# VITE_ENABLE_POLLING=true
